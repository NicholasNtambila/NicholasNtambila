{
  "name": "sunga-manager",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace @sanitech/mobile",
    "android": "npm run android --workspace @sanitech/mobile",
    "ios": "npm run ios --workspace @sanitech/mobile",
    "web": "npm run web --workspace @sanitech/mobile",
    "lint": "npm run lint --workspace @sanitech/mobile",
    "typecheck": "npm run typecheck --workspace @sanitech/mobile && tsc --noEmit -p packages/shared/tsconfig.json",
    "test": "vitest run",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:seed-test-users": "node scripts/seed-local-test-users.mjs",
    "db:test": "npx supabase test db",
    "db:lint": "npx supabase db lint --local --fail-on error",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "npm run doctor --workspace @sanitech/mobile",
    "build:web": "npm run build:web --workspace @sanitech/mobile",
    "verify": "npm run lint && npm run typecheck && npm test && npm run doctor && npm run format:check"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "prettier": "^3.9.10",
    "vitest": "^5.0.4"
  }
}
